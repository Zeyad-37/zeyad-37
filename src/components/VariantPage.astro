---
import Base from '../layouts/Base.astro';
import Editorial from './Editorial.astro';
import Engineering from './Engineering.astro';
import Warm from './Warm.astro';
import type { Variant } from '../data/site';

interface Props { variant: Variant }
const { variant } = Astro.props;

const font = (families: string) => `https://fonts.googleapis.com/css2?${families}&display=swap`;
const config = {
  editorial: {
    Component: Editorial,
    themeColor: '#f7f4ee',
    fonts: font('family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400'),
  },
  engineering: {
    Component: Engineering,
    themeColor: '#0d1117',
    fonts: font('family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600'),
  },
  warm: {
    Component: Warm,
    themeColor: '#fbf8f3',
    fonts: font('family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=IBM+Plex+Mono:wght@400'),
  },
}[variant];
const { Component } = config;
---
<Base variant={variant} fonts={config.fonts} themeColor={config.themeColor}>
  <Component />
</Base>
